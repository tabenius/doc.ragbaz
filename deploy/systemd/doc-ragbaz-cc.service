[Unit]
Description=doc.ragbaz.cc static Docusaurus site (docker compose, rootless)
Wants=docker.service
After=docker.service default.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/data/src/doc.ragbaz.cc/deploy
Environment=DOCKER_HOST=unix://%t/docker.sock
Environment=XDG_RUNTIME_DIR=%t
Environment=COMPOSE_PROJECT_NAME=doc-ragbaz-cc
Environment=DOC_IMAGE=registry.ragbaz.cc/ragbaz/doc-ragbaz-cc:latest
ExecStart=/usr/bin/docker compose -f docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml down

[Install]
WantedBy=default.target
