{
  "name": "doc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "lint:md": "markdownlint README.md docs src/pages",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "verify": "npm run lint:md && npm run typecheck && npm run build",
    "precision": "node scripts/precision-study.mjs",
    "precision:verify": "node scripts/precision-study.mjs --verify",
    "test:numerics": "node scripts/exact.test.mjs",
    "test:numerics:selftest": "node -e \"import('./scripts/lib/lin.mjs').then(m=>{const r=m.selfTest();const ok=r.agreeIdentity===1&&Math.abs(r.ac1)<0.05&&Math.abs(r.ac3)<0.05&&r.ridgeTargets.every(t=>t.squaredError<1e-20);console.log(ok?'  lin.mjs selfTest ok':'  lin.mjs selfTest FAILED');process.exit(ok?0:1)})\""
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@mdx-js/react": "^3.0.0",
    "@types/cytoscape": "^3.21.9",
    "clsx": "^2.0.0",
    "cytoscape": "^3.34.0",
    "cytoscape-dagre": "^4.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "markdownlint-cli": "0.49.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
