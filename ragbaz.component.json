{
  "$schema": "https://ragbaz.cc/schemas/ragbaz.component.schema.json",
  "schemaVersion": "0.2.0",
  "identity": {
    "id": "ragbaz.docs-site",
    "name": "RAGBAZ Atlas Docs Site",
    "version": "0.1.0",
    "repoPath": "doc.ragbaz.cc",
    "repository": "tabenius/doc.ragbaz",
    "owner": "ragbaz",
    "lifecycle": "production"
  },
  "commercial": {
    "packageTags": [
      "docs-atlas",
      "sales-collateral"
    ],
    "personas": [
      "buyer",
      "operator",
      "agent-team"
    ],
    "supportTier": "managed",
    "salesStatus": "demo",
    "pricingTags": [
      "included-collateral"
    ],
    "demoUrl": "https://ragbaz.cc/doc/"
  },
  "capabilities": {
    "provides": [
      {
        "id": "docs.site",
        "label": "Published documentation atlas",
        "version": "0.1.0",
        "supportTier": "production",
        "description": "Docusaurus static documentation atlas for products, infrastructure, experiments, and generated workspace artifacts."
      }
    ]
  },
  "requires": {
    "services": [
      {
        "capability": "artifact.registry",
        "componentId": "ragbaz.registry",
        "optional": true,
        "reason": "Deployment bundle image is published through the private registry."
      }
    ],
    "dns": [
      {
        "name": "doc.ragbaz.cc",
        "recordType": "A"
      }
    ]
  },
  "provides": {
    "endpoints": [
      {
        "name": "public-docs",
        "protocol": "https",
        "urlEnv": "RAGBAZ_DOCS_URL",
        "capabilities": [
          "docs.site"
        ],
        "auth": "none",
        "tenantScoped": false
      }
    ],
    "artifacts": [
      {
        "name": "static-site",
        "mediaType": "text/html",
        "digestRequired": true,
        "signatureRequired": false
      },
      {
        "name": "nginx-image",
        "mediaType": "application/vnd.oci.image.manifest.v1+json",
        "digestRequired": true,
        "signatureRequired": false
      }
    ],
    "adminSurfaces": [
      {
        "name": "docusaurus-build",
        "description": "Docusaurus build and static deployment bundle.",
        "capabilities": [
          "docs.site"
        ]
      }
    ]
  },
  "config": {
    "knobs": [
      {
        "name": "site-url",
        "env": "RAGBAZ_DOCS_URL",
        "type": "url",
        "required": true,
        "control": "operator",
        "description": "Public documentation atlas URL."
      }
    ]
  },
  "security": {
    "authMethods": [
      "none"
    ],
    "tenantBoundary": "none",
    "dataClasses": [
      "public",
      "logs"
    ],
    "secretAccess": "none",
    "revocation": "Remove HAProxy route or stop the docs container.",
    "auditEvents": [
      "docs.site.deployed"
    ]
  },
  "health": {
    "checks": [
      {
        "name": "public-home",
        "type": "http",
        "target": "https://ragbaz.cc/doc/",
        "intervalSeconds": 300,
        "timeoutSeconds": 10,
        "required": true
      }
    ]
  },
  "compatibility": {
    "contracts": [
      {
        "name": "docusaurus-static-site",
        "version": "0.1.0",
        "test": "npm run build"
      }
    ]
  },
  "docs": {
    "readme": "README.md",
    "public": "https://ragbaz.cc/doc/",
    "runbook": "deploy/README.md"
  },
  "metadata": {
    "candidateWave": "component-manifest-candidate-wave"
  },
  "presentation": {
    "featured": {
      "order": 70,
      "status": "live",
      "label": "atlas + docs",
      "title": "product atlas / and *status*",
      "description": "The documentation and operations surface for RAGBAZ products, specs, status checks, deployment notes, and design-system references.",
      "tags": [
        "ragbaz.cc/doc",
        "status",
        "design system"
      ],
      "panel": {
        "label": "what it does",
        "icon": "<path d=\"M12 18h18l6 6h16v22H12z\"/><path d=\"M36 18v8\"/><path d=\"M24 34h16\"/><path d=\"M24 42h12\"/>",
        "bullets": [
          "publishes product specs and implementation notes",
          "keeps product status, deployment notes, and uptime information discoverable",
          "anchors every surface to the RAGBAZ visual system"
        ]
      },
      "links": [
        {
          "label": "atlas already lives in the main site",
          "muted": true
        }
      ]
    }
  }
}
